# 前端环境变量配置模板
# 复制此文件为 .env 并填写实际值

# API 基础路径
# 开发环境：http://localhost:5234/api
# 生产环境：https://your-domain.com/api
NUXT_PUBLIC_API_BASE=http://localhost:5234/api

# 管理后台登录（Nitro /api/auth/login，必填）
# 用户名固定为 admin，仅校验此密码
ADMIN_PASSWORD=your_admin_password
# 可选：JWT 签名密钥，默认复用 ADMIN_PASSWORD
# ADMIN_AUTH_SECRET=
